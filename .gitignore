# ElvUI-Grimfall — only track the fork's addon folders.
# Ignore everything at the AddOns root, then re-include the fork folders.
/*

!/.gitignore
!/README.md

!/ElvUI/
!/ElvUI_AddOnSkins/
!/ElvUI_AuraBarsMovers/
!/ElvUI_BagControl/
!/ElvUI_CastBarOverlay/
!/ElvUI_CustomTags/
!/ElvUI_CustomTweaks/
!/ElvUI_DataTextColors/
!/ElvUI_DTBars2/
!/ElvUI_Enhanced/
!/ElvUI_EnhancedFriendsList/
!/ElvUI_ExtraActionBars/
!/ElvUI_OptionsUI/
!/ElvUI_RaidMarkers/
!/ElvUI_SwingBar/

# Logo image is hosted on GitHub's CDN (linked from the README), not committed.
ElvUI/ElvUI.png

# Common junk inside tracked folders
*.bak
*.zip
*.broken
Thumbs.db
.DS_Store
